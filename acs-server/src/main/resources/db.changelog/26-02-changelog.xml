<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1753563521303-3" author="PC">
        <createTable tableName="acs_dynamic_groups">
            <column name="subject_type_id" type="VARCHAR(128)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_acs_dynamic_groups"/>
            </column>
            <column name="subject_id" type="VARCHAR(128)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_acs_dynamic_groups"/>
            </column>
            <column name="group_name" type="VARCHAR(128)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_acs_dynamic_groups"/>
            </column>
            <column name="parent_subject_type_id" type="VARCHAR(128)"/>
            <column name="parent_subject_id" type="VARCHAR(128)"/>
            <column name="parent_group_id" type="VARCHAR(128)"/>
        </createTable>
    </changeSet>
    <changeSet id="1753563521303-4" author="PC">
        <createTable tableName="acs_dynamic_groups_nodes">
            <column name="group_name" type="VARCHAR(128)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_acs_dynamic_groups_nodes"/>
            </column>
            <column name="group_subject_id" type="VARCHAR(128)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_acs_dynamic_groups_nodes"/>
            </column>
            <column name="group_subject_type_id" type="VARCHAR(128)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_acs_dynamic_groups_nodes"/>
            </column>
            <column name="node_value" type="VARCHAR(128)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_acs_dynamic_groups_nodes"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1753563521303-5" author="PC">
        <addColumn tableName="acs_grants">
            <column name="group_subject_id" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
    <changeSet id="1753563521303-6" author="PC">
        <addColumn tableName="acs_subject_types">
            <column name="supports_dynamic_groups" type="BOOLEAN"/>
        </addColumn>
    </changeSet>
    <changeSet id="1753563521303-7" author="PC">
        <addPrimaryKey columnNames="group_name, group_subject_type_id, node_value" constraintName="pk_acs_groups_nodes"
                       tableName="acs_groups_nodes"/>
    </changeSet>
    <changeSet id="1753563521303-8" author="PC">
        <addPrimaryKey columnNames="node_value, subject_type_id" constraintName="pk_acs_subject_types_nodes"
                       tableName="acs_subject_types_nodes"/>
    </changeSet>
    <changeSet id="1753563521303-9" author="PC">
        <addForeignKeyConstraint baseColumnNames="parent_subject_type_id,parent_subject_id,parent_group_id"
                                 baseTableName="acs_dynamic_groups"
                                 constraintName="FK_ACS_DYNAMIC_GROUPS_ON_PASUTYIDPASUIDPAGRID"
                                 referencedColumnNames="subject_type_id,subject_id,group_name"
                                 referencedTableName="acs_dynamic_groups"/>
    </changeSet>
    <changeSet id="1753563521303-10" author="PC">
        <addForeignKeyConstraint baseColumnNames="subject_type_id" baseTableName="acs_dynamic_groups"
                                 constraintName="FK_ACS_DYNAMIC_GROUPS_ON_SUBJECT_TYPE" referencedColumnNames="id"
                                 referencedTableName="acs_subject_types"/>
    </changeSet>
    <changeSet id="1753563521303-11" author="PC">
        <addForeignKeyConstraint baseColumnNames="subject_id,subject_type_id" baseTableName="acs_dynamic_groups"
                                 constraintName="FK_ACS_DYNAMIC_GROUPS_ON_SUIDSUTYID"
                                 referencedColumnNames="id,subject_type_id" referencedTableName="acs_subjects"/>
    </changeSet>
    <changeSet id="1753563521303-12" author="PC">
        <addForeignKeyConstraint baseColumnNames="group_subject_type_id,group_subject_id,group_name"
                                 baseTableName="acs_grants" constraintName="FK_ACS_GRANTS_ON_GRSUTYIDGRSUIDGRNA"
                                 referencedColumnNames="subject_type_id,subject_id,group_name"
                                 referencedTableName="acs_dynamic_groups"/>
    </changeSet>
    <changeSet id="1753563521303-13" author="PC">
        <addForeignKeyConstraint baseColumnNames="group_subject_type_id,group_subject_id,group_name"
                                 baseTableName="acs_dynamic_groups_nodes"
                                 constraintName="fk_acsdyngronod_on_dynamic_group_entity"
                                 referencedColumnNames="subject_type_id,subject_id,group_name"
                                 referencedTableName="acs_dynamic_groups"/>
    </changeSet>
    <changeSet id="1753563521303-14" author="PC">
        <addForeignKeyConstraint baseColumnNames="node_value" baseTableName="acs_dynamic_groups_nodes"
                                 constraintName="fk_acsdyngronod_on_node_entity" referencedColumnNames="value"
                                 referencedTableName="acs_nodes"/>
    </changeSet>
</databaseChangeLog>